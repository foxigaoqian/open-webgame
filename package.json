{
  "name": "open-webgame",
  "version": "0.3.3",
  "private": true,
  "type": "module",
  "description": "Agent skill and production QA workflow that turns a game keyword into a playable, game-native, search-ready website.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/foxigaoqian/open-webgame.git"
  },
  "homepage": "https://foxigaoqian.github.io/open-webgame/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "init:game": "node scripts/init.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:seo": "node scripts/seo-audit.mjs",
    "check:content": "node scripts/content-audit.mjs",
    "check:site": "node scripts/site-audit.mjs",
    "check:security": "node scripts/security-audit.mjs",
    "check:i18n": "node scripts/i18n-audit.mjs",
    "check:http": "node scripts/http-audit.mjs",
    "check:deps": "npm audit --audit-level=high",
    "verify:embed": "node scripts/verify-embed.mjs",
    "verify:embed:config": "node scripts/verify-embed.mjs --offline",
    "qa": "node scripts/qa.mjs",
    "qa:release": "node scripts/release-qa.mjs",
    "qa:example": "node scripts/qa.mjs --config examples/scam-artist-site/open-webgame.json --html examples/scam-artist-site/index.html --offline",
    "qa:live:example": "node scripts/qa.mjs --config examples/scam-artist-site/open-webgame.json --html examples/scam-artist-site/index.html",
    "qa:release:example": "node scripts/release-qa.mjs --config examples/scam-artist-site/open-webgame.json --html examples/scam-artist-site/index.html --site-dir examples/scam-artist-site",
    "qa:browser": "node scripts/browser-qa.mjs",
    "qa:browser:example": "node scripts/browser-qa.mjs --config examples/scam-artist-site/open-webgame.json --site-dir examples/scam-artist-site",
    "qa:lighthouse": "node scripts/lighthouse-qa.mjs",
    "qa:lighthouse:example": "node scripts/lighthouse-qa.mjs --config examples/scam-artist-site/open-webgame.json --site-dir examples/scam-artist-site",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "ajv": "^8.17.1",
    "chrome-launcher": "^1.0.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.54.2"
  }
}
