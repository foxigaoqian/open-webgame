{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foxigaoqian/open-webgame/schema/open-webgame.schema.json",
  "title": "Open WebGame Project Config",
  "type": "object",
  "required": ["schemaVersion", "game", "site", "seo", "embed", "design", "status"],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "game": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "developer": { "type": "string" },
        "genre": { "type": "string" },
        "officialUrl": { "type": "string" },
        "platforms": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "site": {
      "type": "object",
      "required": ["language", "mode"],
      "properties": {
        "language": { "type": "string", "minLength": 2 },
        "mode": { "enum": ["auto", "play-first", "guide"] },
        "domain": { "type": "string" },
        "canonical": { "type": "string" },
        "stack": { "type": "string" },
        "deploymentTarget": { "type": "string" }
      },
      "additionalProperties": true
    },
    "seo": {
      "type": "object",
      "required": ["primaryIntent", "primaryKeyword", "canonicalPagePurpose"],
      "properties": {
        "primaryIntent": { "type": "string", "minLength": 1 },
        "primaryKeyword": { "type": "string", "minLength": 1 },
        "secondaryIntents": { "type": "array", "items": { "type": "string" } },
        "canonicalPagePurpose": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "embed": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "verified", "unsupported", "manual-check-required"] },
        "runtimeUrl": { "type": "string" },
        "officialPage": { "type": "string" },
        "host": { "type": "string" }
      },
      "additionalProperties": true
    },
    "design": {
      "type": "object",
      "properties": {
        "direction": { "type": "string" },
        "palette": { "type": "array", "items": { "type": "string" } },
        "density": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "object",
      "required": ["research", "onPageSeo", "deploymentReady", "blockingIssues"],
      "properties": {
        "research": { "enum": ["pending", "resolved"] },
        "onPageSeo": { "enum": ["pending", "pass", "fail"] },
        "deploymentReady": { "type": "boolean" },
        "blockingIssues": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
