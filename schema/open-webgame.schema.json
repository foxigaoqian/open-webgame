{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/foxigaoqian/open-webgame/schema/open-webgame.schema.json",
  "title": "Open WebGame Project Config",
  "type": "object",
  "required": ["schemaVersion", "game", "site", "seo", "embed", "design", "sources", "claims", "pages", "security", "status"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "0.3.3" },
    "game": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "developer": { "type": "string" },
        "genre": { "type": "string" },
        "officialUrl": { "type": "string" },
        "platforms": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "required": ["language", "mode", "origin", "basePath", "canonical"],
      "properties": {
        "language": { "$ref": "#/$defs/languageCode" },
        "mode": { "enum": ["auto", "play-first", "guide"] },
        "origin": { "type": "string" },
        "basePath": { "type": "string", "pattern": "^$|^/(?:[^/]+(?:/[^/]+)*)?$" },
        "canonical": { "type": "string" },
        "stack": { "type": "string" },
        "deploymentTarget": { "type": "string" }
      },
      "additionalProperties": false
    },
    "i18n": {
      "type": "object",
      "required": ["enabled", "defaultLanguage", "languages"],
      "properties": {
        "enabled": { "type": "boolean" },
        "defaultLanguage": { "$ref": "#/$defs/languageCode" },
        "xDefaultLanguage": { "$ref": "#/$defs/languageCode" },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["code", "label", "prefix"],
            "properties": {
              "code": { "$ref": "#/$defs/languageCode" },
              "label": { "type": "string", "minLength": 1 },
              "prefix": { "type": "string", "pattern": "^$|^/(?:[^/]+(?:/[^/]+)*)?$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "required": ["primaryIntent", "primaryKeyword", "canonicalPagePurpose"],
      "properties": {
        "primaryIntent": { "type": "string", "minLength": 1 },
        "primaryKeyword": { "type": "string", "minLength": 1 },
        "secondaryIntents": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "canonicalPagePurpose": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "embed": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "verified", "unsupported", "manual-check-required"] },
        "runtimeUrl": { "type": "string" },
        "officialPage": { "type": "string" },
        "host": { "type": "string" }
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object",
      "properties": {
        "direction": { "type": "string" },
        "palette": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "density": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "url"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["official-site", "itch", "steam", "developer", "devlog", "verified-gameplay", "other"] },
          "url": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "retrievedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:T.*)?$" }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "sourceIds", "status", "volatility"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "sourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["verified", "pending", "rejected"] },
          "volatility": { "enum": ["stable", "volatile"] },
          "maxAgeDays": { "type": "integer", "minimum": 1, "maximum": 3650 },
          "usedIn": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": { "properties": { "volatility": { "const": "volatile" } }, "required": ["volatility"] },
            "then": {
              "properties": { "maxAgeDays": { "type": "integer", "minimum": 1, "maximum": 3650 } },
              "required": ["maxAgeDays"]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "file", "intent", "canonical", "indexable"],
        "properties": {
          "path": { "type": "string", "minLength": 1, "pattern": "^/" },
          "file": { "type": "string", "minLength": 1 },
          "intent": { "type": "string", "minLength": 1 },
          "canonical": { "type": "string" },
          "title": { "type": "string" },
          "indexable": { "type": "boolean" },
          "language": { "$ref": "#/$defs/languageCode" },
          "translationKey": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "security": {
      "type": "object",
      "required": ["allowedIframePermissions"],
      "properties": {
        "allowedIframePermissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["autoplay", "fullscreen", "gamepad", "clipboard-read", "clipboard-write", "cross-origin-isolated", "geolocation", "microphone", "camera", "midi", "gyroscope", "accelerometer", "xr-spatial-tracking", "web-share", "monetization"] }
        },
        "requireNoopenerForBlankTargets": { "type": "boolean" },
        "allowInlineScripts": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": ["research", "onPageSeo", "blockingIssues"],
      "properties": {
        "research": { "enum": ["pending", "resolved"] },
        "onPageSeo": { "enum": ["pending", "pass", "fail"] },
        "blockingIssues": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "languageCode": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    }
  },
  "additionalProperties": false
}
